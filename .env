# =============================================================================
# Obsidian Wiki — Environment Configuration
# =============================================================================

# --- Required ---
OBSIDIAN_VAULT_PATH=/home/user/Documents/rome

# GitHub remote for vault sync (set by setup.sh when you enable GitHub sync)
# wiki-sync uses this to push committed vault changes
VAULT_GITHUB_REMOTE=
OBSIDIAN_SOURCES_DIR=
OBSIDIAN_CATEGORIES=concepts,entities,skills,references,synthesis,journal,scenarios
OBSIDIAN_MAX_PAGES_PER_INGEST=15
WIKI_SKIP_PROJECTS=
CLAUDE_HISTORY_PATH=
CODEX_HISTORY_PATH=
PI_HISTORY_PATH=
LINT_SCHEDULE=weekly
OBSIDIAN_LINK_FORMAT=wikilink

# --- QMD Semantic Search (optional) ---
QMD_WIKI_COLLECTION=rome
QMD_PAPERS_COLLECTION=
QMD_TRANSPORT=cli
QMD_CLI_SEARCH_MODE=quality
QMD_CLI="env -u CI qmd"

# --- Token Budget & Writes ---
WIKI_TOKEN_WARN_THRESHOLD=100000
WIKI_STAGED_WRITES=false

# --- Raw Staging Directory ---
OBSIDIAN_RAW_DIR=_raw

# --- Antfly Search & Local Embeddings ---
ANTFLY_URL=http://127.0.0.1:18080
ANTFLY_TABLE=rome
ANTFLY_INDEX=body_dense_octen
ANTFLY_GENERATOR={"provider":"ollama","model":"bakeoff-qwen3-coder-q5kxl:latest","url":"http://172.17.0.1:11434/v1","max_tokens":4096}
ANTFLY_GENERATOR_SYNTHESIS={"provider":"ollama","model":"hf.co/bartowski/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-GGUF:Q4_K_S","url":"http://172.17.0.1:11434/v1","max_tokens":4096}
